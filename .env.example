# Runtime mode
SERVICEOPS_ENVIRONMENT=local

# Public URLs
SERVICEOPS_PUBLIC_WEB_BASE_URL=http://localhost:3000
SERVICEOPS_PUBLIC_API_BASE_URL=http://localhost:8000
SERVICEOPS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
VITE_SERVICEOPS_API_BASE_URL=http://localhost:8000

# Local port bindings
SERVICEOPS_API_HOST=0.0.0.0
SERVICEOPS_API_PORT=8000
SERVICEOPS_WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=serviceops
POSTGRES_USER=serviceops
POSTGRES_PASSWORD=serviceops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SERVICEOPS_DATABASE_URL=postgresql+psycopg://serviceops:serviceops@postgres:5432/serviceops

# Redis
SERVICEOPS_REDIS_URL=redis://redis:6379/0
SERVICEOPS_REDIS_BROKER_URL=redis://redis:6379/0
SERVICEOPS_REDIS_RESULT_BACKEND=redis://redis:6379/1

# Staff access
SERVICEOPS_STAFF_AUTH_SECRET=local-dev-staff-auth-secret-change-me
SERVICEOPS_STAFF_TOKEN_TTL_SECONDS=43200
SERVICEOPS_STAFF_DEV_USERNAME=dispatcher@coffeefix.local
SERVICEOPS_STAFF_DEV_PASSWORD=dispatcher-local
SERVICEOPS_STAFF_DEV_ROLES=dispatcher

# One-time production first-admin bootstrap
SERVICEOPS_BOOTSTRAP_ADMIN_USERNAME=
SERVICEOPS_BOOTSTRAP_ADMIN_DISPLAY_NAME=
SERVICEOPS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional production smoke-test staff credentials
SERVICEOPS_SMOKE_STAFF_USERNAME=
SERVICEOPS_SMOKE_STAFF_PASSWORD=

# Knowledge base and AI
SERVICEOPS_KNOWLEDGE_SQLITE_PATH=.local/serviceops-knowledge.sqlite3
SERVICEOPS_KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
SERVICEOPS_KNOWLEDGE_RETRIEVAL_LIMIT=5
SERVICEOPS_EMBEDDING_PROVIDER=deterministic
SERVICEOPS_EMBEDDING_MODEL=text-embedding-3-small
SERVICEOPS_EMBEDDING_API_BASE_URL=https://api.openai.com/v1
SERVICEOPS_EMBEDDING_API_KEY=
SERVICEOPS_EMBEDDING_TIMEOUT_SECONDS=20
SERVICEOPS_EMBEDDING_MAX_RETRIES=2
SERVICEOPS_AI_SQLITE_PATH=.local/serviceops-ai.sqlite3
SERVICEOPS_AI_PROVIDER=deterministic
SERVICEOPS_AI_MODEL=gpt-4.1-mini
SERVICEOPS_AI_API_BASE_URL=https://api.openai.com/v1
SERVICEOPS_AI_API_KEY=
SERVICEOPS_AI_TIMEOUT_SECONDS=20
SERVICEOPS_AI_MAX_RETRIES=2
SERVICEOPS_AI_SUGGESTION_LIMIT=3

# Telegram integration
SERVICEOPS_TELEGRAM_BOT_TOKEN=change-me
SERVICEOPS_TELEGRAM_BOT_USERNAME=coffeefix_service_bot
SERVICEOPS_TELEGRAM_BOT_API_SECRET=change-me

# n8n integration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=serviceops-admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-32-byte-minimum-production-key
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
SERVICEOPS_N8N_WEBHOOK_SHARED_SECRET=change-me
SERVICEOPS_N8N_CALLBACK_SECRET=change-me
SERVICEOPS_N8N_REQUEST_CREATED_WEBHOOK_URL=http://n8n:5678/webhook/serviceops/request-created
SERVICEOPS_N8N_STATUS_CHANGED_WEBHOOK_URL=http://n8n:5678/webhook/serviceops/status-changed
SERVICEOPS_N8N_CLARIFICATION_WEBHOOK_URL=http://n8n:5678/webhook/serviceops/clarification-requested
SERVICEOPS_N8N_CUSTOMER_ANSWERED_WEBHOOK_URL=http://n8n:5678/webhook/serviceops/customer-answered
SERVICEOPS_API_BASE_URL=http://api:8000
SERVICEOPS_PUBLIC_API_BASE_URL=http://localhost:8000
SERVICEOPS_DISPATCHER_TELEGRAM_CHAT_ID=change-me

# Backups
SERVICEOPS_BACKUP_DIR=./backups
SERVICEOPS_BACKUP_RETENTION_DAYS=14
