          "name": "Validate Secret And Format Clarification Notification",
          "parameters": {
            "jsCode": "const secret = $json.headers['x-serviceops-webhook-secret'] || $json.headers['X-ServiceOps-Webhook-Secret'];\nif (secret !== $env.SERVICEOPS_N8N_WEBHOOK_SHARED_SECRET) { throw new Error('Invalid ServiceOps webhook secret'); }\nconst event = $json.body;\nconst payload = event.payload || {};\nconst question = String(payload.question || 'Откройте страницу статуса и ответьте на вопрос сервисного центра.');\nconst nl = String.fromCharCode(10);\nconst text = [\n  'Нужно уточнение по заявке',\n  '',\n  'Заявка: ' + payload.request_number,\n  'Вопрос сервисного центра:',\n  question,\n  '',\n  'Ответить можно на странице статуса:',\n  payload.public_status_url,\n].join('\n');\nreturn { event_id: event.event_id, event_type: event.event_type, request_number: event.request_number, chat_id: payload.telegram_chat_id || payload.telegram_handle, text };",
            "language": "javaScript",
            "mode": "runOnceForEachItem"
          },
          "position": [
            224,
            0
          ],
          "type": "n8n-nodes-base.code",
          "typeVersion": 2
        },
