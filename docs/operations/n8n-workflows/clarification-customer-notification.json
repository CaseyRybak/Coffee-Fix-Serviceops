        "name": "Validate Secret And Format Clarification Notification",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const secret = $json.headers['x-serviceops-webhook-secret'] || $json.headers['X-ServiceOps-Webhook-Secret'];\nconst expectedSecret = $env.SERVICEOPS_N8N_WEBHOOK_SHARED_SECRET;\nif (secret !== expectedSecret) { throw new Error('Invalid ServiceOps webhook secret'); }\nconst event = $json.body;\nconst payload = event.payload || {};\nconst question = String(payload.question || 'Откройте страницу статуса и ответьте на вопрос сервисного центра.');\nconst nl = String.fromCharCode(10);\nconst text = [\n  'Нужно уточнение по заявке',\n  '',\n  'Заявка: ' + payload.request_number,\n  'Вопрос сервисного центра:',\n  question,\n  '',\n  'Ответить можно на странице статуса:',\n  payload.public_status_url,\n].join(nl);\nreturn { event_id: event.event_id, event_type: event.event_type, request_number: event.request_number, chat_id: payload.telegram_chat_id || payload.telegram_handle, text };"
        }
      },
      {
        "id": "94d9cc45-7a94-4b60-98b2-fd9567cec574",
        "name": "Send Telegram Message",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          448,
          0
        ],
        "parameters": {
          "method": "POST",
          "url": "={{ \"https://api.telegram.org/bot\" + $env.SERVICEOPS_TELEGRAM_BOT_TOKEN + \"/sendMessage\" }}",
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{ { chat_id: $json.chat_id, text: $json.text, disable_web_page_preview: true } }}",
          "options": {
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true,
                "responseFormat": "json"
              }
            },
            "timeout": 10000
          }
        }
      },
      {
        "id": "1e241519-5933-43ba-8ffa-78903c205b3b",
        "name": "Report Delivery Result",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          672,
