          "id": "94d9cc45-7a94-4b60-98b2-fd9567cec574",
          "name": "Send Telegram Message",
          "parameters": {
            "contentType": "json",
            "jsonBody": "={ { chat_id: $json.chat_id, text: $json.text, disable_web_page_preview: true } }",
            "method": "POST",
            "options": {
              "response": {
                "response": {
                  "fullResponse": true,
                  "neverError": true,
                  "responseFormat": "json"
                }
              },
              "timeout": 10000
            },
            "sendBody": true,
            "specifyBody": "json",
            "url": "={ \"https://api.telegram.org/bot\" + $env.SERVICEOPS_TELEGRAM_BOT_TOKEN + \"/sendMessage\" }"
          },
          "position": [
            448,
